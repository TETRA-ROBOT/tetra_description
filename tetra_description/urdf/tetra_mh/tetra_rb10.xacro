<?xml version="1.0"?>
<!--
  TETRA-MH + Rainbow RB10 로봇팔 (휴머노이드 구성). MH 브링업이 use_rb10:=true 일 때 rb10_arm.launch.py 가 이 파일로
  robot_state_publisher·ros2_control·MoveIt 을 띄운다 (몸체 URDF 와 팔 URDF 를 따로 띄우면 robot_state_publisher 가 둘이 된다).

  팔 모델(rbpodo_description)은 이 프로젝트 밖 워크스페이스(~/rainbow)에 있다. robot.env 의 TETRA_EXTRA_ROS_SETUP 으로 불러온다.
  예전 ~/rainbow/src/rbpodo_moveit_config/config/test.urdf.xacro(팔 + ~/ros2_ws tetraDS 몸체)를 대신한다. 장착 자세(rb_joint)는 같다.
-->
<robot name="rb" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="model_id" default="rb10_1300e" />

  <!-- Autonics RGBD 카메라 장착 위치: gripper(로봇팔 끝) | pantilt(머리 팬틸트) | none.
       팬틸트 xacro(herkulex_description test.xacro)가 같은 인자를 pantilt 기본으로 선언하므로 그보다 먼저 선언한다 -->
  <xacro:arg name="autonics_camera_mount" default="gripper" />
  <!-- 그리퍼 장착 자리: 팔 끝단 원(플랜지 면) 중심 = rbpodo 의 tcp 링크 기준 (m·rad). 2026-11-24 실측:
       마지막 손목 위쪽, 끝단 원 중심에서 카메라 중심까지 17.5 cm. tcp 의 -y 가 공구(보는) 방향, -z 가 위쪽이다.
       카메라 메시(mh_assy_camera.stl) 원점은 앞면 근처라 몸체 중심이 메시 좌표 (-28.7, -9.1, 1.7) mm 에 있어,
       중심이 tcp 기준 (0, 0, -175) mm 에 오도록 원점을 그만큼 옮긴 값이다 -->
  <xacro:arg name="autonics_gripper_xyz" default="-0.0091 -0.0287 -0.1733" />
  <!-- 카메라 앞(메시 +x)이 공구 방향(tcp -y)을 보게 z 축 -90°, 위아래가 실제와 맞게 앞 축으로 180° (roll) -->
  <xacro:arg name="autonics_gripper_rpy" default="3.1416 0 -1.5708" />

  <xacro:include filename="$(find rbpodo_description)/robots/$(arg model_id).urdf.xacro" />
  <xacro:include filename="$(find tetra_description)/urdf/tetra_mh/tetra.xacro" />

  <!-- 몸통 앞면에 팔 베이스를 붙인다 (예전 test.urdf.xacro 와 같은 값) -->
  <joint name="rb_joint" type="fixed">
    <origin xyz="0.1 0.0 0.0" rpy="0 -1.57 3.14" />
    <parent link="torso" />
    <child link="link0" />
  </joint>

  <xacro:if value="${'$(arg autonics_camera_mount)' == 'gripper'}">
    <joint name="mh_assy_camera_joint" type="fixed">
      <origin xyz="$(arg autonics_gripper_xyz)" rpy="$(arg autonics_gripper_rpy)" />
      <parent link="tcp" />
      <child link="mh_assy_camera" />
    </joint>
  </xacro:if>
</robot>
