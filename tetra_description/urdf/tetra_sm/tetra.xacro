<?xml version="1.0"?>

<robot name="tetra" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <xacro:property name="base_length" value="0.473" />
  <xacro:property name="base_radius" value="0.2365" />
  <xacro:property name="wheel_length" value="0.047" />
  <xacro:property name="wheel_radius" value="0.085" />
  <xacro:property name="wheel_offset_x" value="0.0" />
  <xacro:property name="wheel_offset_y" value="0.207" /> <!--0.220-->
  <xacro:property name="wheel_offset_z" value="-0.100" />
  <xacro:property name="PI" value="3.1415926" />

  <xacro:macro name="cylinder_inertia" params="m r h">
        <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}" />
  </xacro:macro>

   <!-- Include all component files -->
   <xacro:include filename="$(find tetra_description)/urdf/tetra_sm/materials.urdf.xacro" />
   <xacro:include filename="$(find tetra_description)/urdf/tetra_sm/base.urdf.xacro" />
   
   <!-- Add the base and wheels -->
   <base name="base" color="black"/>
  
  <link name="laser">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="laser_flag" type="fixed">
    <!--<origin xyz="0.060 0 0.210" rpy="0 0 -0.296706" />-->
    <origin xyz="0.060 0 0.210" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="laser" />
  </joint>

  <!-- Kanavi R270 - 장착 위치와 방향은 EDU(tetra_edu/tetra.xacro)와 동일 -->
  <link name="lidar_link" />

  <joint name="base_link_to_lidar_link" type="fixed">
    <origin xyz="0.045 0 0.17" rpy="0 0 ${-PI/2}" />
    <parent link="base_link"/>
    <child link="lidar_link" />
  </joint>
  
  <link name="laser_link2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_laser_link2" type="fixed">
    <origin xyz="-0.350 0.0 0.2436" rpy="0 0 ${PI}" />
    <parent link="base_link"/>
    <child link="laser_link2" />
  </joint>

  <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_imu_link" type="fixed">
    <origin xyz="-0.025 0 0.232" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="imu_link" />
  </joint>

 <link name="camera">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.11 0.0 0.181" rpy="1.5708 3.14159 1.5708"/>
    <parent link="base_link"/>
    <child link="camera" />
  </joint>  

 <link name="front_bumper">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.30 0.01" />
        </geometry>
        <material name="transparentblack" />
      </visual>
  </link>

  <joint name="front_bumper_joint" type="fixed">
    <origin xyz="0.12625 0.0 -0.05" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="front_bumper" />
  </joint>

  <link name="camera1_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <!-- RealSense 드라이버(camera_name camera1)는 camera1_link 를 depth 원점(왼쪽 IR 센서)으로 보고
       그 아래 컬러 센서 오프셋(D435 는 +0.015 m)을 TF 로 붙인다. 카메라 본체는 로봇 가운데지만
       D435 의 depth 원점은 본체 중심에서 왼쪽 0.0175 m 라 y 를 0.0175 로 둔다 (컬러 센서는 왼쪽 0.0325 m).
       y 0 이면 도킹이 태그 중심보다 1.75 cm 옆으로 맞춰진다. 다른 모델(D455 0.0475)이면 이 값을 바꾼다 -->
  <joint name="camera1_link_joint" type="fixed">
    <origin xyz="0.1097 0.0175 0.1344" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="camera1_link" />
  </joint>
  
  <!-- Livox MID360 (tetra_3d_bringup_sm, frame_id livox_frame). S 와 같은 자리에 둔다 (tetra_s/tetra.xacro). 실측하면 고친다 -->
   <link name="livox_frame">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_livox_frame" type="fixed">
    <origin xyz="-0.0915 0.0 0.404" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="livox_frame" />
  </joint>  

<!--
 <link name="base_upperlink">
   <visual>
    <origin xyz=" 0 0 0 " rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://tetra_description/meshes/platform_body_u.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="transparentred"/>        
    </visual>
      <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="${base_length}" radius="${base_radius}"/>
            </geometry>
      </collision>
  </link>

  <joint name="base_upperlink" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="base_upperlink" />
  </joint>
-->


</robot>


