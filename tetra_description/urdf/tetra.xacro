<?xml version="1.0"?>

<robot name="tetra" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <xacro:property name="base_length" value="0.473" />
  <xacro:property name="base_radius" value="0.2365" />
  <xacro:property name="wheel_length" value="0.047" />
  <xacro:property name="wheel_radius" value="0.085" />
  <xacro:property name="wheel_offset_x" value="0.0" />
  <xacro:property name="wheel_offset_y" value="0.207" /> <!--0.220-->
  <xacro:property name="wheel_offset_z" value="-0.100" />
  <xacro:property name="PI" value="3.1415926" />

  <xacro:macro name="cylinder_inertia" params="m r h">
        <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}" />
  </xacro:macro>

   <!-- Include all component files -->
   <xacro:include filename="$(find tetra_description)/urdf/materials.urdf.xacro" />
   <xacro:include filename="$(find tetra_description)/urdf/base.urdf.xacro" /> 
   
   <!-- Add the base and wheels -->
   <base name="base" color="black"/>
 

  <!-- M 앞 라이다 SICK TiM571 (sick_tim_5xx 드라이버). 메쉬 원점이 광학 중심이라 laser 프레임에 그대로 붙인다 (meshes/sick_tim_5xx.NOTICE.md) -->
  <link name="laser">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://tetra_description/meshes/sick_tim_5xx.stl" scale="1 1 1" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_laser_link" type="fixed">
    <origin xyz="0.1372 0 0.142" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="laser" />
  </joint>

  <link name="laser_link2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_laser_link2" type="fixed">
    <origin xyz="-0.3955 0.0 0.211" rpy="0 0 ${PI}" />
    <parent link="base_link"/>
    <child link="laser_link2" />
  </joint>

  <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="base_link_to_imu_link" type="fixed">
    <origin xyz="0.0 0 0.2" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="imu_link" />
  </joint>

 <link name="camera">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="-0.38775 0.0 0.1807" rpy="1.5708 3.14159 4.71239"/>
    <parent link="base_link"/>
    <child link="camera" />
  </joint>  


 <link name="front_bumper">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.48 0.01" />
        </geometry>
        <material name="transparentblack" />
      </visual>
  </link>

  <joint name="front_bumper_joint" type="fixed">
    <origin xyz="0.2 0.0 -0.05" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="front_bumper" />
  </joint>


 <link name="camera1_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
  </link>

  <joint name="camera1_link_joint" type="fixed">
    <origin xyz="0.1749 0.0 0.0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="camera1_link" />
  </joint>

  <!-- Rear ultrasonic sensors of older M robots (no rear Cyglidar).
       tetra_power_driver publishes range_points_dl/rl/rr/dr in these frames when ultrasonic_option is on,
       and navigation_m.yaml marks them in the local costmap. Offsets come from the legacy TETRA-DS URDF. -->
  <xacro:macro name="sonar_frame" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.01 0.01 0.01" />
        </geometry>
        <material name="grey" />
      </visual>
    </link>
    <joint name="base_link_to_${name}" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="base_link"/>
      <child link="${name}" />
    </joint>
  </xacro:macro>

  <!-- 이 파일은 EDU·H·MH·S·SM 도 읽는다. 다른 모델 전원 보드가 초음파를 내면 M 위치로 잘못 찍히므로 M 브링업만 켠다
       (tetra_bringup_m.launch.py, tetra_3d_bringup.launch.py 가 m_rear_sonar:=true) -->
  <xacro:arg name="m_rear_sonar" default="false"/>
  <xacro:if value="$(arg m_rear_sonar)">
    <xacro:sonar_frame name="sonar_DL" xyz="-0.34654 0.245 -0.02517" rpy="0 0 1.5708" />
    <xacro:sonar_frame name="sonar_RL" xyz="-0.3902 0.18754 0.197" rpy="0 0 3.14159" />
    <xacro:sonar_frame name="sonar_RR" xyz="-0.3902 -0.18754 0.197" rpy="0 0 3.14159" />
    <xacro:sonar_frame name="sonar_DR" xyz="-0.34654 -0.245 -0.02517" rpy="0 0 -1.5708" />
  </xacro:if>


</robot>



