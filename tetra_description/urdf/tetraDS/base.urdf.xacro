<?xml version="1.0"?>

<robot name="tetraDS" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define a number of dimensions using properties -->
  <xacro:property name="wheel_offset_x" value="0.0" />
  <xacro:property name="wheel_offset_y" value="0.395" /> 
  <xacro:property name="wheel_offset_z" value="0.0" />
  <xacro:property name="caster_offset_x" value="0.255" />
  <xacro:property name="caster_offset_y" value="0.339" />
  <xacro:property name="caster_offset_z" value="0.03" />
  <!-- 메쉬를 바닥에 닿게 내리는 양. base_joint 는 0.1 m 인데 이 모델의 바퀴 반지름은 0.085 m 라 몸체·바퀴가 1.5 cm 떠 보였다.
       base_joint 를 바꾸면 base_link 기준 센서 높이(3D 라이다 높이 필터 등)가 같이 바뀌므로, TF 는 그대로 두고 메쉬(visual·collision)만 내린다.
       센서 높이를 실측해 base_joint 를 바로잡을 때는 이 값을 0 으로 하고 센서 joint z 를 함께 고친다. -->
  <xacro:property name="floor_drop" value="0.015" />
  <xacro:property name="PI" value="3.1415926" />

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}" />
  </xacro:macro>
     
  <!-- define a wheel -->
  <link name="base_l_wheel_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 ${PI/2}" />
      <geometry>
        <mesh filename="package://tetra_description/meshes/Wheel Left.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="DarkGrey"/>
    </visual>
  </link>

  <joint name="base_l_wheel_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="base_l_wheel_link"/>
  </joint>

  <link name="base_r_wheel_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 ${PI/2}" />
      <geometry>
        <mesh filename="package://tetra_description/meshes/Wheel Right.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="DarkGrey"/>
    </visual>
  </link>
  
  <joint name="base_r_wheel_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="base_r_wheel_link"/>
  </joint>

  <!-- The base xacro macro -->
  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" /> 
      <geometry>
	      <box size="0.868 0.868 0.001" />
      </geometry>
      <material name="TransparentGreen" />
    </visual>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tetra_description/meshes/Platform Body_L.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="Black"/>        
    </visual>
    <collision>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0"/>
      <geometry>
          <mesh filename="package://tetra_description/meshes/Platform Body_L.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  
  <joint name="base_joint" type="fixed"> <!--fixed-->   
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>

  <link name="front_l_caster_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0" />
	    <geometry>
	      <mesh filename="package://tetra_description/meshes/Caster Yoke.STL" scale="0.001 0.001 0.001" />
	    </geometry>
	    <material name="TransparentYellow"/>
    </visual>
  </link>

  <joint name="front_l_caster_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${caster_offset_x} ${caster_offset_y} ${caster_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="front_l_caster_link"/>
  </joint>

  <link name="front_r_caster_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0" />
	    <geometry>
	      <mesh filename="package://tetra_description/meshes/Caster Yoke.STL" scale="0.001 0.001 0.001" />
	    </geometry>
	    <material name="TransparentYellow"/>
    </visual>
  </link>

  <joint name="front_r_caster_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${caster_offset_x} ${-caster_offset_y} ${caster_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="front_r_caster_link"/>
  </joint>

  <link name="behind_l_caster_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0" />
    	<geometry>
    	  <mesh filename="package://tetra_description/meshes/Caster Yoke.STL" scale="0.001 0.001 0.001" />
	    </geometry>
	    <material name="TransparentYellow"/>
    </visual>
  </link>

  <joint name="behind_l_caster_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${-caster_offset_x} ${caster_offset_y} ${caster_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="behind_l_caster_link"/>
  </joint>

  <link name="behind_r_caster_link">
    <visual>
      <origin xyz="0 0 ${-floor_drop}" rpy="0 0 0" />
    	<geometry>
    	  <mesh filename="package://tetra_description/meshes/Caster Yoke.STL" scale="0.001 0.001 0.001" />
	    </geometry>
	    <material name="TransparentYellow"/>
    </visual>
  </link>
 
  <joint name="behind_r_caster_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="${-caster_offset_x} ${-caster_offset_y} ${caster_offset_z}" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="behind_r_caster_link"/>
  </joint>


  <link name="tim571_f_lidar">
    <visual>
      <origin xyz="0.38013 -0.38013 ${0.10 - floor_drop}" rpy="1.5708 0 -1.5708" /> <!-- an inaccurate figure because it used only for model display -->
      <geometry>
        <mesh filename="package://tetra_description/meshes/tim571.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="Black"/>
    </visual>
  </link>

  <joint name="tim571_f_lidar" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="tim571_f_lidar"/>
  </joint>

  <link name="tim571_b_lidar">
    <visual>
      <origin xyz="-0.38013 0.38013 ${0.10 - floor_drop}" rpy="1.5708 0 1.5708" /> <!-- an inaccurate figure because it used only for model display -->
      <geometry>
        <mesh filename="package://tetra_description/meshes/tim571.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="Black"/>
    </visual>
  </link>
 
 <joint name="tim571_b_lidar" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="tim571_b_lidar"/>
  </joint>

</robot>
